    {
      "apply": {
        "model": "create_stats:block/solar_panel"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "create_stats:block/solar_panel_rail_north"
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "create_stats:block/solar_panel_rail_south"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "create_stats:block/solar_panel_rail_east"
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "create_stats:block/solar_panel_rail_west"
      }
    }
  ]
}
